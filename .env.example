# GoHighLevel MCP server (@drausal/gohighlevel-mcp)
#
# Private Integration Token (PIT) from GoHighLevel:
#   Settings -> Private Integrations -> create a token with the scopes you need.
# The MCP server sends this as the HTTP bearer token on every API call.
# .mcp.json maps it to BEARER_TOKEN_BEARERAUTH / BEARER_TOKEN_BEARER, which are
# the only names the server actually reads.
GHL_API_KEY=

# Your sub-account (location) ID. The MCP server does NOT read this — it has no
# location env var. Most of its tools take locationId as a call parameter, so
# keep it here for reference and pass it when invoking a tool.
GHL_LOCATION_ID=
